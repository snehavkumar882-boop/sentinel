# ==============================================================================
# SENTINEL ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# Application Settings
SENTINEL_APP_NAME="SENTINEL"
SENTINEL_ENVIRONMENT="development"
SENTINEL_DEBUG=true
SENTINEL_LOG_LEVEL="INFO"
SENTINEL_HOST="127.0.0.1"
SENTINEL_PORT=8000

# Database Settings
SENTINEL_DATABASE_URL="sqlite:///./data/sentinel.db"

# Storage Settings
SENTINEL_DATA_DIR="./data"
SENTINEL_VECTOR_DB_DIR="./data/vector_store"

# Machine Learning Engine Settings
SENTINEL_ANOMALY_ZSCORE_THRESHOLD=3.0
SENTINEL_ISOLATION_FOREST_CONTAMINATION=0.05

# Knowledge / RAG Settings
SENTINEL_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
SENTINEL_RAG_TOP_K=5

# Agent & LLM Settings (Optional / Configurable for future phases)
SENTINEL_LLM_PROVIDER="mock"
SENTINEL_LLM_MODEL="mock-reasoning-v1"
SENTINEL_OPENAI_API_KEY=""
SENTINEL_ANTHROPIC_API_KEY=""
SENTINEL_GEMINI_API_KEY=""
